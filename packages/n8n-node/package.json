{
  "name": "@immuva/n8n-node",
  "version": "1.0.1",
  "description": "n8n community node for Immuva Proof — prove, verify, proveSession",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ImmuvaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ImmuvaProof/ImmuvaProof.node.js"
    ]
  },
  "dependencies": {
    "@immuva/sdk": "workspace:*"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "keywords": ["n8n-community-node-package", "immuva", "proof", "ai", "audit"],
  "license": "MIT"
}
